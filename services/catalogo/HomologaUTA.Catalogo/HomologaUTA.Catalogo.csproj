<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.32" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    <PackageReference Include="PdfPig" Version="0.1.16" />

    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <PackageReference Include="RabbitMQ.Client" Version="7.2.2" />
  </ItemGroup>

  <!-- El código real vive en la carpeta de arriba (Controllers, Models, Services, Data, Migrations).
       Lo compilamos aquí sin tocar el Dockerfile. -->
  <ItemGroup>
    <Compile Include="..\**\*.cs" Exclude="..\HomologaUTA.Catalogo\**;..\catalogo.Tests\**;..\**\bin\**;..\**\obj\**" />
  </ItemGroup>

  <!-- Mallas de la HU-03: origen de datos de la memoria del agente -->
  <ItemGroup>
    <EmbeddedResource Include="..\Data\Mallas\*.json" LogicalName="Mallas.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
