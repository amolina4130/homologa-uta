{
  "ReverseProxy": {
    "Routes": {
      "auth-login": {
        "ClusterId": "auth",
        "AuthorizationPolicy": "Anonymous",
        "Match": { "Path": "/auth/login" }
      },
      "auth": {
        "ClusterId": "auth",
        "AuthorizationPolicy": "autenticado",
        "Match": { "Path": "/auth/{**catch-all}" }
      },
      "carreras": {
        "ClusterId": "solicitudes",
        "AuthorizationPolicy": "autenticado",
        "Match": { "Path": "/carreras/{**catch-all}" }
      },
      "solicitudes": {
        "ClusterId": "solicitudes",
        "AuthorizationPolicy": "estudiante",
        "Match": { "Path": "/solicitudes/{**catch-all}" }
      },
      "reglas-consulta": {
        "ClusterId": "reglas",
        "AuthorizationPolicy": "autenticado",
        "Match": { "Path": "/reglas/{**catch-all}", "Methods": [ "GET" ] }
      },
      "reglas-modificar": {
        "ClusterId": "reglas",
        "AuthorizationPolicy": "administrador",
        "Match": { "Path": "/reglas/{**catch-all}", "Methods": [ "PUT" ] }
      }
    },
    "Clusters": {
      "auth": {
        "Destinations": {
          "d1": { "Address": "http://auth-service:8080/" }
        }
      },
      "solicitudes": {
        "Destinations": {
          "d1": { "Address": "http://solicitudes-service:8080/" }
        }
      },
      "reglas": {
        "Destinations": {
          "d1": { "Address": "http://reglas-service:8080/" }
        }
      }
    }
  }
}