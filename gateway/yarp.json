{
  "ReverseProxy": {
    "Routes": {
      "auth-login": {
        "ClusterId": "auth",
        "AuthorizationPolicy": "Anonymous",
        "Match": { "Path": "/auth/login" }
      },
      "auth-registro": {
        "ClusterId": "auth",
        "AuthorizationPolicy": "Anonymous",
        "Match": { "Path": "/auth/registro" }
      },
      "auth-docentes": {
        "ClusterId": "auth",
        "AuthorizationPolicy": "coordinador",
        "Match": { "Path": "/auth/docentes" }
      },
      "auth": {
        "ClusterId": "auth",
        "AuthorizationPolicy": "autenticado",
        "Match": { "Path": "/auth/{**catch-all}" }
      },
      "carreras": {
        "ClusterId": "solicitudes",
        "AuthorizationPolicy": "autenticado",
        "Match": { "Path": "/carreras/{**catch-all}" }
      },
      "asignaturas": {
        "ClusterId": "solicitudes",
        "AuthorizationPolicy": "autenticado",
        "Match": { "Path": "/asignaturas/{**catch-all}" }
      },
      "planes-analiticos": {
        "ClusterId": "solicitudes",
        "AuthorizationPolicy": "administrador",
        "Match": { "Path": "/planes-analiticos/{**catch-all}" }
      },
      "equivalencias-consulta": {
        "ClusterId": "solicitudes",
        "AuthorizationPolicy": "autenticado",
        "Match": { "Path": "/equivalencias/{**catch-all}", "Methods": [ "GET" ] }
      },
      "equivalencias-modificar": {
        "ClusterId": "solicitudes",
        "AuthorizationPolicy": "administrador",
        "Match": { "Path": "/equivalencias/{**catch-all}" }
      },
      "memoria-consulta": {
        "ClusterId": "solicitudes",
        "AuthorizationPolicy": "autenticado",
        "Match": { "Path": "/memoria/{**catch-all}", "Methods": [ "GET" ] }
      },
      "memoria-cargar": {
        "ClusterId": "solicitudes",
        "AuthorizationPolicy": "administrador",
        "Match": { "Path": "/memoria/{**catch-all}" }
      },
      "solicitudes": {
        "ClusterId": "solicitudes",
        "AuthorizationPolicy": "gestor",
        "Match": { "Path": "/solicitudes/{**catch-all}" }
      },
      "reglas-consulta": {
        "ClusterId": "reglas",
        "AuthorizationPolicy": "autenticado",
        "Match": { "Path": "/reglas/{**catch-all}", "Methods": [ "GET" ] }
      },
      "reglas-modificar": {
        "ClusterId": "reglas",
        "AuthorizationPolicy": "administrador",
        "Match": { "Path": "/reglas/{**catch-all}", "Methods": [ "PUT" ] }
      },
      "homologacion-comite": {
        "ClusterId": "homologacion",
        "AuthorizationPolicy": "comite",
        "Order": -1,
        "Match": { "Path": "/homologacion/comite/{**catch-all}" }
      },
      "homologacion-docente": {
        "ClusterId": "homologacion",
        "AuthorizationPolicy": "docente",
        "Order": -1,
        "Match": { "Path": "/homologacion/docente/{**catch-all}" }
      },
      "homologacion-coordinador": {
        "ClusterId": "homologacion",
        "AuthorizationPolicy": "coordinador",
        "Order": -1,
        "Match": { "Path": "/homologacion/coordinador/{**catch-all}" }
      },
      "homologacion": {
        "ClusterId": "homologacion",
        "AuthorizationPolicy": "autenticado",
        "Match": { "Path": "/homologacion/{**catch-all}" }
      },
      "documentos-descarga": {
        "ClusterId": "documentos",
        "AuthorizationPolicy": "Anonymous",
        "Order": -1,
        "Match": { "Path": "/documentos/descargar/{**catch-all}" }
      },
      "documentos": {
        "ClusterId": "documentos",
        "AuthorizationPolicy": "gestor",
        "Match": { "Path": "/documentos/{**catch-all}" }
      },
      "salud": {
        "ClusterId": "homologacion",
        "AuthorizationPolicy": "Anonymous",
        "Order": -1,
        "Match": { "Path": "/salud/{**catch-all}" }
      }
    },
    "Clusters": {
      "auth": {
        "Destinations": {
          "d1": { "Address": "http://auth-service:8080/" }
        }
      },
      "solicitudes": {
        "Destinations": {
          "d1": { "Address": "http://solicitudes-service:8080/" }
        }
      },
      "reglas": {
        "Destinations": {
          "d1": { "Address": "http://reglas-service:8080/" }
        }
      },
      "homologacion": {
        "HttpRequest": {
          "RequestTimeout": "00:15:00",
          "ActivityTimeout": "00:15:00"
        },
        "Destinations": {
          "d1": { "Address": "http://homologacion-service:8080/" }
        }
      },
      "documentos": {
        "Destinations": {
          "d1": { "Address": "http://documentos-service:8080/" }
        }
      }
    }
  }
}
