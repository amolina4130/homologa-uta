{
  "ReverseProxy": {
    "Routes": {
      "auth-login": {
        "ClusterId": "auth",
        "AuthorizationPolicy": "Anonymous",
        "Match": { "Path": "/auth/login" }
      },
      "auth": {
        "ClusterId": "auth",
        "AuthorizationPolicy": "autenticado",
        "Match": { "Path": "/auth/{**catch-all}" }
      },
      "carreras": {
        "ClusterId": "solicitudes",
        "AuthorizationPolicy": "autenticado",
        "Match": { "Path": "/carreras/{**catch-all}" }
      },
      "solicitudes": {
        "ClusterId": "solicitudes",
        "AuthorizationPolicy": "estudiante",
        "Match": { "Path": "/solicitudes/{**catch-all}" }
      },
      "reglas-consulta": {
        "ClusterId": "reglas",
        "AuthorizationPolicy": "autenticado",
        "Match": { "Path": "/reglas/{**catch-all}", "Methods": [ "GET" ] }
      },
      "reglas-modificar": {
        "ClusterId": "reglas",
        "AuthorizationPolicy": "administrador",
        "Match": { "Path": "/reglas/{**catch-all}", "Methods": [ "PUT" ] }
      },
      "homologacion-coordinador": {
        "ClusterId": "homologacion",
        "AuthorizationPolicy": "coordinador",
        "Order": -1,
        "Match": { "Path": "/homologacion/coordinador/{**catch-all}" }
      },
      "homologacion": {
        "ClusterId": "homologacion",
        "AuthorizationPolicy": "autenticado",
        "Match": { "Path": "/homologacion/{**catch-all}" }
      },
      "documentos-descarga": {
        "ClusterId": "documentos",
        "AuthorizationPolicy": "Anonymous",
        "Order": -1,
        "Match": { "Path": "/documentos/descargar/{**catch-all}" }
      },
      "documentos": {
        "ClusterId": "documentos",
        "AuthorizationPolicy": "estudiante",
        "Match": { "Path": "/documentos/{**catch-all}" }
      }
    },
    "Clusters": {
      "auth": {
        "Destinations": {
          "d1": { "Address": "http://auth-service:8080/" }
        }
      },
      "solicitudes": {
        "Destinations": {
          "d1": { "Address": "http://solicitudes-service:8080/" }
        }
      },
      "reglas": {
        "Destinations": {
          "d1": { "Address": "http://reglas-service:8080/" }
        }
      },
      "homologacion": {
        "Destinations": {
          "d1": { "Address": "http://homologacion-service:8080/" }
        }
      },
      "documentos": {
        "Destinations": {
          "d1": { "Address": "http://documentos-service:8080/" }
        }
      }
    }
  }
}