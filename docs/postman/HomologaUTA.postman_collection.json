  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "1.1 Login Exitoso",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.collectionVariables.set(\"token\", jsonData.token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"correo\": \"estudiante@uta.edu.ec\",\n    \"contrasena\": \"Demo123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "http://localhost:8080/auth/login",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Pruebas de Seguridad",
      "item": [
        {
          "name": "2.1 Acceso con Token Válido (200)",
          "request": {
